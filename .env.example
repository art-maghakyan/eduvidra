##############################################################################
# Local development defaults.
#
# These values match the services defined in docker-compose.override.yml, so
# `cp .env.example .env` + `docker compose up -d` gives you a working stack.
# Hostnames (db, redis, elasticsearch) are Docker Compose service names.
##############################################################################

APP_NAME=Eduvidra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Comma-separated previous APP_KEYs, kept readable during a key rotation.
# APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12

# Exposed to the frontend bundle at build time; the deploy scripts set it to the
# short git SHA of the deployed commit.
VITE_APP_NAME="${APP_NAME}"
VITE_APP_VERSION=dev

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14
# LOG_STDERR_FORMATTER=

# --- Database (Postgres 17 in the `db` container) ---------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=eduvidra_db
DB_USERNAME=dev_user
DB_PASSWORD=dev_password
# DB_URL=
# DB_SSLMODE=prefer

# --- Session / cache / queue ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave false locally (no HTTPS); production must set this to true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

# --- Queue dashboard (Laravel Horizon) --------------------------------------
# Access is gated by the `admin.access` permission — see HorizonServiceProvider.
HORIZON_PATH=horizon
HORIZON_NAME=eduvidra
# HORIZON_DOMAIN=

# --- Mail -------------------------------------------------------------------
# `log` writes messages to the log file instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SNS topic ARN(s) allowed to POST SES bounce/complaint notifications to
# /webhooks/ses. Comma-separated. REQUIRED wherever the webhook is reachable —
# an unset value makes the endpoint reject every delivery. Not needed locally.
SES_WEBHOOK_TOPIC_ARN=

# --- AWS --------------------------------------------------------------------
# Empty locally. On EC2 these stay empty too — the SDK reads the instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Search (Laravel Scout) -------------------------------------------------
# Dev uses Elasticsearch as a showcase. Production runs no ES infra and sets
# SCOUT_DRIVER=database to search Postgres directly — identical code and UI,
# $0 infra. The ELASTIC_* and SCOUT_QUEUE_* vars are ignored under `database`.
# See docs/search-integration.md.
SCOUT_DRIVER=elastic
SCOUT_QUEUE_CONNECTION=redis
SCOUT_QUEUE_NAME=search
# SCOUT_PREFIX=
ELASTIC_HOST=elasticsearch:9200
# Makes indexed documents immediately searchable — useful in tests, slow in prod.
# ELASTIC_SCOUT_DRIVER_REFRESH_DOCUMENTS=false

# --- SEO --------------------------------------------------------------------
SEO_SITE_NAME="${APP_NAME}"
SEO_OG_IMAGE=/images/og-eduvidra.jpg
SEO_TWITTER_SITE=

# --- AI chat tutor (Anthropic API) ------------------------------------------
# Key is workspace-scoped (eduvidra-dev) and expires 30 days from creation.
# Read only via config('anthropic.*') — never env() outside config/anthropic.php,
# because production runs config:cache. See docs/ai-chat-tutor.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# fake | real — `fake` makes zero network calls and costs $0.
ANTHROPIC_DRIVER=fake
# Optional. Seconds a streamed reply may run; must stay under nginx's
# fastcgi_read_timeout (300s). Config default is 120.
# ANTHROPIC_STREAM_TIMEOUT=120
# Optional. Prompt cache TTL: unset = API default of 5 minutes, or 1h (writes
# cost 2x input instead of 1.25x), or false to disable caching.
# ANTHROPIC_CACHE_TTL=
# Optional. Questions per user per day (default 10), and the replayed-history
# token budget / trim floor. Both budget values must stay above 4,096 or prompt
# caching becomes permanently inert. See docs/ai-chat-tutor.md.
# ANTHROPIC_DAILY_MESSAGE_LIMIT=10
# ANTHROPIC_HISTORY_TOKEN_BUDGET=12000
# ANTHROPIC_HISTORY_TOKEN_FLOOR=6000

# Optional. Days of silence after which the replay treats the thread as a fresh
# start; the turns before the gap are left to the summariser instead of being
# re-sent. 0 replays the whole thread from the beginning.
# ANTHROPIC_HISTORY_GAP_DAYS=14
