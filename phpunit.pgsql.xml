<?xml version="1.0" encoding="UTF-8"?>
<!--
    Postgres variant of phpunit.xml, used only by the `phpunit:pgsql` CI job.

    Production runs Postgres while the default suite runs in-memory SQLite, and
    the conversations migration contains the repo's only raw DDL (two partial
    unique indexes). A regression there would pass on SQLite and ship broken.

    KEEP IN SYNC WITH phpunit.xml. Everything below is identical except the
    DB_* block; PHPUnit has no include mechanism, so the duplication is
    unavoidable. The env vars are NOT forced, so the CI job supplies the
    connection details.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="ANTHROPIC_DRIVER" value="fake" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="SCOUT_DRIVER" value="collection" force="true"/>
        <env name="SCOUT_QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
