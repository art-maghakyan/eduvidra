APP_NAME=Eduvidra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://eduvidra.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME.eu-central-1.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=eduvidra
DB_USERNAME=eduvidra
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production sends via AWS SES (transport defined in config/mail.php).
# Credentials come from the EC2 IAM role (see AWS_* below) — no SMTP user/pass.
# MAIL_FROM_ADDRESS must be on a domain identity verified in SES (eu-central-1).
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@eduvidra.com"
MAIL_FROM_NAME="${APP_NAME}"

# On EC2 the IAM instance role provides credentials;
# leave access keys EMPTY so the AWS SDK picks them up from the role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=CHANGE_ME
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
